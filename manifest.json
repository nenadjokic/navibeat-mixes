    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Playlists",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/prefix"
            },
            {
              "type": "Control",
              "scope": "#/properties/mixSize"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Which mixes to build",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/enableMorning"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableAfternoon"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableEvening"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableNight"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableRediscover"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableWrapped"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableNewMusic"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableLoved"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableOnRepeat"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableEssentials"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDiscovery"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableGenreRadio"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableArtistRadio"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDailyMix"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDecade"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Names",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/name.morning"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.afternoon"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.evening"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.night"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.rediscover"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Tuning",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/rediscoverMonths"
            },
            {
              "type": "Control",
              "scope": "#/properties/minEventsForAffinity"
            },
            {
              "type": "Control",
              "scope": "#/properties/genreDenylist"
            },
            {
              "type": "Control",
              "scope": "#/properties/genreNoiseThreshold"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Sharing",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/wrappedSharing"
            }
          ]
        },
        {
          "type": "Group",
          "label": "How NaviBeat draws them",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/mixStyle"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Button icons and colours (only used when the style above is Button)",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/icon.morning"
            },
            {
              "type": "Control",
              "scope": "#/properties/color.morning"
            },
            {
              "type": "Control",
              "scope": "#/properties/icon.afternoon"
            },
            {
