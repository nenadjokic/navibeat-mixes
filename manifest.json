    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Playlists",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/prefix"
            },
            {
              "type": "Control",
              "scope": "#/properties/onlyForUsers"
            },
            {
              "type": "Control",
              "scope": "#/properties/mixSize"
            },
            {
              "type": "Control",
              "scope": "#/properties/maxPerArtist"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Which mixes to build",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/enableMorning"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableAfternoon"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableEvening"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableNight"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableRediscover"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableWrapped"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableNewMusic"
            },
            {
              "type": "Control",
              "scope": "#/properties/newMusicOrder"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableLoved"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableOnRepeat"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableEssentials"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDiscovery"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableGenreRadio"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableArtistRadio"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDailyMix"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDecade"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Names",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/nameMorning"
            },
            {
              "type": "Control",
              "scope": "#/properties/nameAfternoon"
            },
            {
              "type": "Control",
              "scope": "#/properties/nameEvening"
            },
            {
              "type": "Control",
              "scope": "#/properties/nameNight"
            },
            {
              "type": "Control",
              "scope": "#/properties/nameRediscover"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Tuning",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/rediscoverMonths"
            },
            {
              "type": "Control",
              "scope": "#/properties/minEventsForAffinity"
            },
            {
              "type": "Control",
              "scope": "#/properties/genreDenylist"
            },
            {
              "type": "Control",
              "scope": "#/properties/genreNoiseThreshold"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Sharing",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/wrappedSharing"
            }
          ]
        },
        {
          "type": "Group",
          "label": "How NaviBeat draws them",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/mixStyle"
            }
          ]
        },
