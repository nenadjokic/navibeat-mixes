{
  "$schema": "https://raw.githubusercontent.com/navidrome/navidrome/refs/heads/master/plugins/manifest-schema.json",
  "name": "NaviBeat Mixes",
  "author": "Nenad Jokic",
  "version": "0.6.2",
  "description": "Listening-aware playlists: time-of-day mixes, Rediscover, and Wrapped recaps.",
  "website": "https://navibeat.app",
  "permissions": {
    "scheduler": {
      "reason": "Required to refresh your mixes on a daily schedule."
    },
    "subsonicapi": {
      "reason": "Required to read your library and create the playlists."
    },
    "users": {
      "reason": "Required to build mixes per user. Every Subsonic call needs a user to act as."
    },
    "kvstore": {
      "reason": "Required to remember when you listen to what, which is what makes the mixes personal. Stays on your server."
    },
    "http": {
      "reason": "ONLY used if you switch on Wrapped sharing, which is off by default. Sends counts and top artist names to navibeat.app to generate a shareable link. Never a play log, never anything identifying your server.",
      "requiredHosts": [
        "navibeat.app"
      ]
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "title": "Playlist name prefix",
          "default": "🟠 ",
          "description": "Goes in front of every playlist name, so the mixes group together in your list."
        },
        "mixSize": {
          "type": "integer",
          "title": "Tracks per mix",
          "default": 30,
          "minimum": 10,
          "maximum": 200
        },
        "maxPerArtist": {
          "type": "integer",
          "title": "Most tracks from one artist",
          "default": 3,
          "minimum": 1,
          "maximum": 20,
          "description": "How many songs a single artist may contribute to one mix. Set it to 1 for a genre radio that spreads across as many artists as possible."
        },
        "rediscoverMonths": {
          "type": "integer",
          "title": "Rediscover: months untouched",
          "default": 6,
          "minimum": 1,
          "maximum": 60,
          "description": "How long ago a track must last have been played to count as forgotten. If Rediscover comes out empty, your listening is simply too current: try 2 or 3."
        },
        "minEventsForAffinity": {
          "type": "integer",
          "title": "Plays before mixes learn your day",
          "default": 150,
          "minimum": 10,
          "maximum": 5000,
          "description": "Until this many plays have been observed, time-of-day mixes are built from your most played music instead, and each playlist says so."
        },
        "enableMorning": {
          "type": "boolean",
          "title": "Morning mix (05:00 to 11:00)",
          "default": true
        },
        "enableAfternoon": {
          "type": "boolean",
          "title": "Afternoon mix (11:00 to 17:00)",
          "default": true
        },
        "enableEvening": {
          "type": "boolean",
          "title": "Evening mix (17:00 to 23:00)",
          "default": true
        },
        "enableNight": {
          "type": "boolean",
          "title": "Night mix (23:00 to 05:00)",
          "default": true
        },
        "enableRediscover": {
          "type": "boolean",
          "title": "Rediscover mix",
          "default": true
        },
        "enableWrapped": {
          "type": "boolean",
          "title": "Wrapped yearly recap",
          "default": true
        },
        "name.morning": {
          "type": "string",
          "title": "Name: Morning",
          "default": "Morning"
        },
        "name.afternoon": {
          "type": "string",
          "title": "Name: Afternoon",
          "default": "Afternoon"
        },
        "name.evening": {
          "type": "string",
          "title": "Name: Evening",
          "default": "Evening"
        },
        "name.night": {
          "type": "string",
          "title": "Name: Night",
          "default": "Night"
        },
        "name.rediscover": {
          "type": "string",
          "title": "Name: Rediscover",
          "default": "Rediscover"
        },
        "genreDenylist": {
          "type": "string",
          "title": "Genres to ignore",
          "default": "Music,Musik,Musique",
          "description": "Comma separated. Junk genres written by tagging tools carry no signal."
        },
        "genreNoiseThreshold": {
          "type": "number",
          "title": "Ignore a genre covering more than",
          "default": 0.6,
          "minimum": 0.1,
          "maximum": 1,
          "description": "A genre on almost every track cannot tell two tracks apart, so it is ignored as a signal. 0.6 means 60 percent of your library."
        },
        "wrappedSharing": {
          "type": "boolean",
          "title": "Share Wrapped for a public link",
          "default": false,
          "description": "OFF by default. When on, and only then, an aggregate is sent to navibeat.app to build a shareable page: counts, your top artist names and your peak listening hour. Never a play log, never track ids, never your username, and nothing identifying your server."
        },
        "enableNewMusic": {
          "type": "boolean",
          "title": "New Music",
          "default": true
        },
        "enableLoved": {
          "type": "boolean",
          "title": "Your Loved Songs",
          "default": true
        },
        "enableOnRepeat": {
          "type": "boolean",
          "title": "On Repeat",
          "default": true
        },
        "enableEssentials": {
          "type": "boolean",
          "title": "Your Essentials",
          "default": true
        },
        "enableDiscovery": {
          "type": "boolean",
          "title": "Weekly Discovery",
          "default": true
        },
        "enableGenreRadio": {
          "type": "boolean",
          "title": "Genre Radio 1 to 3",
          "default": true
        },
        "enableArtistRadio": {
          "type": "boolean",
          "title": "Artist Radio 1 to 5",
          "default": true
        },
        "enableDailyMix": {
          "type": "boolean",
          "title": "Daily Mix 1 to 3",
          "default": true
        },
        "enableDecade": {
          "type": "boolean",
          "title": "Decade mixes",
          "default": true
        }
      }
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Playlists",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/prefix"
            },
            {
              "type": "Control",
              "scope": "#/properties/mixSize"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Which mixes to build",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/enableMorning"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableAfternoon"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableEvening"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableNight"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableRediscover"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableWrapped"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableNewMusic"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableLoved"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableOnRepeat"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableEssentials"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDiscovery"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableGenreRadio"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableArtistRadio"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDailyMix"
            },
            {
              "type": "Control",
              "scope": "#/properties/enableDecade"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Names",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/name.morning"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.afternoon"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.evening"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.night"
            },
            {
              "type": "Control",
              "scope": "#/properties/name.rediscover"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Tuning",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/rediscoverMonths"
            },
            {
              "type": "Control",
              "scope": "#/properties/minEventsForAffinity"
            },
            {
              "type": "Control",
              "scope": "#/properties/genreDenylist"
            },
            {
              "type": "Control",
              "scope": "#/properties/genreNoiseThreshold"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Sharing",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/wrappedSharing"
            }
          ]
        }
      ]
    }
  }
}
